{
  "name": "cp-content-viewer",
  "version": "0.1.1",
  "description": "Rich, extensible content viewer for Exoscient control panels.",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./content-viewer.css": "./dist/content-viewer.css"
  },
  "files": [
    "dist"
  ],
